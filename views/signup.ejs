<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sign Up</title>
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <div class="auth-container">
    <div class="auth-card">
      <h2>Sign Up</h2>

      <% if (error) { %>
        <p class="error-msg"><%= error %></p>
      <% } %>

      <form action="/api/auth/register-user" method="POST">
        <input type="text" name="username" placeholder="Username" required value="<%= username || '' %>">
        <input type="email" name="email" placeholder="Email" required value="<%= email || '' %>">
        <input type="password" name="password" placeholder="Password" required>
        <button type="submit">Sign Up</button>
      </form>

      <p class="switch-link">Already have an account? <a href="/signin">Sign In</a></p>
    </div>
  </div>
</body>
</html>
