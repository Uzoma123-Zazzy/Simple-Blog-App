<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sign Up</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-card">
    <h2>Sign Up</h2>

    <% if (error) { %>
      <p class="error-msg"><%= error %></p>
    <% } %>

    <form action="https://simple-blog-app-nu.vercel.app/api/auth/register-user" method="POST">
      <input type="text" name="username" placeholder="Username" required value="<%= username || '' %>">
      <input type="email" name="email" placeholder="Email" required value="<%= email || '' %>">
      <input type="password" name="password" placeholder="Password" required>
      <button type="submit">Sign Up</button>
    </form>

    <p>Already have an account? <a href="/signin">Sign In</a></p>
  </div>
</body>
</html>
